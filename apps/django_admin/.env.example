DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_USE_POSTGRES=false
POSTGRES_DB=letsgo
POSTGRES_USER=letsgo
POSTGRES_PASSWORD=letsgo
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_ADMIN_USERNAME=operations
DJANGO_ADMIN_EMAIL=operations@letsgo.local
DJANGO_ADMIN_PASSWORD=

# Safaricom Daraja M-PESA Express (STK Push). Keep credentials on Django only.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-host.example/api/payments/mpesa/callback/
# PayBill default: CustomerPayBillOnline. For a Till, set the HO/store shortcode
# above, MPESA_PARTY_B to the Till number, and use CustomerBuyGoodsOnline.
MPESA_PARTY_B=174379
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

